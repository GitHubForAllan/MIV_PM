rules_version = '2';

// 越南力山工業 廠務系統 — Firestore 安全規則
//
// 權限模型與 auth-guard.js 的 mivResolvePerms() 一致：
//   users/{uid}.role == 'admin'                → 全部系統的使用與管理權限
//   users/{uid}.useApps / .manageApps（陣列）  → 逐系統授權（新格式）
//   兩個陣列都沒有的舊帳號                      → 依 role 套用舊的預設對照
// 系統代碼：andon / toolroom / issue / calibration / inspection /
//           container / techreq / purchase
//
// 免登入例外（配合現場使用方式）：
//   - andon/config  安燈看板（andon.html）在產線電視牆上唯讀顯示
//   - issues        問題反映（issue-report.html）現場直接回報

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 使用者權限解析 ──────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function hasUserDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function udoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function urole() {
      return hasUserDoc() ? udoc().get('role', '') : '';
    }
    function isAdmin() {
      return urole() == 'admin';
    }
    // 已轉存成新格式（admin-users.html 儲存後就會有這兩個欄位之一）
    function isMigrated() {
      return hasUserDoc() && udoc().keys().hasAny(['useApps', 'manageApps']);
    }

    // 舊帳號的預設對照，與 auth-guard.js 的 LEGACY_* 相同（admin 另由 isAdmin 涵蓋）
    function legacyManage(app) {
      return (app == 'toolroom' && urole() == 'toolroom')
          || (app == 'calibration' && urole() == 'quality')
          || (app == 'inspection' && urole() == 'quality')
          || (app == 'purchase' && urole() in ['production', 'toolroom', 'quality']);
    }
    function legacyUse(app) {
      return legacyManage(app)
          || ((app == 'calibration' || app == 'inspection')
                ? urole() in ['viewer', 'production', 'quality']
                : urole() in ['viewer', 'production', 'toolroom', 'quality']);
    }

    function canManage(app) {
      return isAdmin()
        || (hasUserDoc()
            && (isMigrated() ? (app in udoc().get('manageApps', []))
                             : legacyManage(app)));
    }
    // 有管理權限者必然也有使用權限
    function canUse(app) {
      return isAdmin()
        || (hasUserDoc()
            && (isMigrated() ? (app in udoc().get('useApps', [])
                                || app in udoc().get('manageApps', []))
                             : legacyUse(app)));
    }

    // ── 使用者權限表 ────────────────────────────────────────────
    // 每個人都要能讀自己的權限（auth-guard 判斷可用功能）；
    // 列出全部與異動權限僅限管理員。
    match /users/{uid} {
      allow get:   if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list:  if isAdmin();
      allow write: if isAdmin();
    }

    // ── 安燈系統 ────────────────────────────────────────────────
    // andon/config：電視牆看板需免登入唯讀。
    // 產線操作（觸發／解除異常）會改 lines.{id}.alert，屬「使用」權限；
    // 新增或刪除產線屬「管理」，因此使用者寫入時產線清單必須維持不變。
    match /andon/config {
      allow read: if true;
      allow write: if canManage('andon')
        || (canUse('andon')
            && resource.data.lines is map
            && request.resource.data.lines is map
            && request.resource.data.lines.keys().hasOnly(resource.data.lines.keys())
            && resource.data.lines.keys().hasOnly(request.resource.data.lines.keys()));
    }
    // PIN 碼（andon/auth）與棟別設定（andon/buildings）：僅安燈管理權限
    match /andon/{docId} {
      allow read:  if canManage('andon');
      allow write: if canManage('andon');
    }
    // 安燈異常紀錄：產線操作時建立與更新
    match /andon-logs/{logId} {
      allow read:   if canUse('andon');
      allow create: if canUse('andon');
      allow update: if canUse('andon');
      allow delete: if canManage('andon');
    }

    // ── 問題反映系統 ────────────────────────────────────────────
    // issue-report.html 為免登入現場回報，維持原行為。
    match /issues/{issueId} {
      allow read, write: if true;
    }

    // ── 工具室系統 ──────────────────────────────────────────────
    // 庫存品項：可使用者檢視；新增／編輯／刪除／入出庫需管理權限
    match /toolroom_items/{itemId} {
      allow read:  if canUse('toolroom');
      allow write: if canManage('toolroom');
    }
    // 領用申請：可使用者檢視並提出申請；審核、修改、刪除需管理權限
    match /toolroom_requisitions/{reqId} {
      allow read:   if canUse('toolroom');
      allow create: if canUse('toolroom');
      allow update: if canManage('toolroom');
      allow delete: if canManage('toolroom');
    }

    // ── 校驗管理 ────────────────────────────────────────────────
    match /calibration_assets/{assetId} {
      allow read:  if canUse('calibration');
      allow write: if canManage('calibration');
    }

    // ── 製程巡檢系統 ────────────────────────────────────────────
    // 站點：紀錄查詢與異常追蹤都需要讀；維護屬後台管理
    match /pi_areas/{areaId} {
      allow read:  if canUse('inspection');
      allow write: if canManage('inspection');
    }
    // 巡檢表單範本：只有實際執行巡檢作業時會用到
    match /pi_checklist_templates/{templateId} {
      allow read:  if canManage('inspection');
      allow write: if canManage('inspection');
    }
    // 巡檢紀錄：可使用者查詢；建立與修改屬巡檢作業
    match /pi_inspection_records/{recordId} {
      allow read:  if canUse('inspection');
      allow write: if canManage('inspection');
    }
    // 巡檢異常單
    match /pi_issues/{issueId} {
      allow read:   if canUse('inspection');
      allow create: if canManage('inspection');   // 由巡檢作業產生
      allow delete: if canManage('inspection');
      // 管理權限可完整更新（含簽核結案／退回）；
      // 一般使用者只能填負責人與改善對策，且不得將狀態改為已結案。
      allow update: if canManage('inspection')
        || (canUse('inspection')
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['assignedTo', 'countermeasure', 'resolutionPhotoUrls', 'status'])
            && request.resource.data.status in ['待處理', '改善中', '待複檢（待主管簽核）']);
    }

    // ── 裝櫃計算工具 ────────────────────────────────────────────
    match /containerModels/{modelId} {
      allow read:  if canUse('container');
      allow write: if canManage('container');
    }

    // ── 技術課委託管理系統 ──────────────────────────────────────
    match /treq_departments/{deptId} {
      allow read:  if canUse('techreq');
      allow write: if canManage('techreq');
    }
    match /treq_categories/{catId} {
      allow read:  if canUse('techreq');
      allow write: if canManage('techreq');
    }
    // 工時單價與技術課受理人員設定
    match /treq_meta/config {
      allow read:  if canUse('techreq');
      allow write: if canManage('techreq');
    }
    // 單號流水號：每位委託人送單時都要遞增，因此開放使用權限者寫入，
    // 但限制只能有 period（年月，如 2609）與 seq 兩個欄位。
    match /treq_meta/counter {
      allow read: if canUse('techreq');
      allow write: if canUse('techreq')
        && request.resource.data.keys().hasOnly(['period', 'seq'])
        && request.resource.data.period is string
        && request.resource.data.seq is number;
    }
    // 委託單：可使用者皆可檢視與送出；後續流程依身分（主管／技術課／本人）
    match /treq_requests/{reqId} {
      allow read: if canUse('techreq');

      // 只能以自己的名義建單，且必須從「待主管簽核」開始
      allow create: if canUse('techreq')
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'pending_approval';

      // 單號與委託人不可被竄改
      allow update: if canUse('techreq')
        && request.resource.data.no == resource.data.no
        && request.resource.data.requesterUid == resource.data.requesterUid;

      // 撤回：限本人且尚未簽核／已被退回；管理權限可刪
      allow delete: if canManage('techreq')
        || (canUse('techreq')
            && resource.data.requesterUid == request.auth.uid
            && resource.data.status in ['pending_approval', 'rejected']);
    }

    // ── 採購進度追蹤 ────────────────────────────────────────────
    // 案件與主檔：可使用者檢視；建立與編輯需管理權限
    match /purchase_cases/{caseId} {
      allow read:  if canUse('purchase');
      allow write: if canManage('purchase');
    }
    match /purchase_units/{unitId} {
      allow read:  if canUse('purchase');
      allow write: if canManage('purchase');
    }
    match /purchase_vendors/{vendorId} {
      allow read:  if canUse('purchase');
      allow write: if canManage('purchase');
    }
    match /purchase_meta/config {
      allow read:  if canUse('purchase');
      allow write: if canManage('purchase');
    }
    // 案件單號流水號：建立案件時遞增，只有可編輯者會用到
    match /purchase_meta/counter {
      allow read: if canUse('purchase');
      allow write: if canManage('purchase')
        && request.resource.data.keys().hasOnly(['period', 'seq'])
        && request.resource.data.period is string
        && request.resource.data.seq is number;
    }
  }
}
